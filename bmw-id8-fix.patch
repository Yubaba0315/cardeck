-/** H.264 level_idc 目标值：4.0（0x28）。真 iPhone 同款流形态。 */
-private const val TARGET_LEVEL_IDC = 40
+/**
+ * 按分辨率/帧率选 H.264 level_idc。
+ *
+ * - 1412x654@30：3649 MBs / 109470 MB/s → 4.0（40）
+ * - 2662x812@30：8517 MBs / 255510 MB/s → 4.2（42）
+ *   （同时超过 Level 4.0 的 8192 MBs 与 245760 MB/s）
+ * - 再大/再高帧率 → 5.0（50）
+ */
+internal fun requiredLevelIdc(width: Int, height: Int, fps: Int): Int {
+    val mb = ((width + 15) / 16) * ((height + 15) / 16)
+    val mbps = mb * fps
+    return when {
+        mb <= 8192 && mbps <= 245760 -> 40
+        mb <= 8704 && mbps <= 522240 -> 42
+        else -> 50
+    }
+}
 
